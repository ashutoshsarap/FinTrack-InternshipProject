@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure Authenticator";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="container-xl">
    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-shield-lock me-2"></i>
                Configure Two-Factor Authentication
            </h3>
        </div>

        <div class="card-body">


            <!-- Step 1 -->
            <div class="mb-5">
                <div class="d-flex align-items-center mb-2">
                    <span class="badge bg-primary me-2">1</span>
                    <h3 class="mb-0">Install an Authenticator App</h3>
                </div>

                <h6 class="text-secondary">
                    Download one of the following authenticator applications:
                </h6>

                <div class="d-flex flex-wrap gap-2">
                    <a href="https://go.microsoft.com/fwlink/?Linkid=825072"
                       target="_blank"
                       class="btn btn-outline-primary">
                        Microsoft Authenticator (Android)
                    </a>

                    <a href="https://go.microsoft.com/fwlink/?Linkid=825073"
                       target="_blank"
                       class="btn btn-outline-primary">
                        Microsoft Authenticator (iOS)
                    </a>

                    <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2"
                       target="_blank"
                       class="btn btn-outline-success">
                        Google Authenticator (Android)
                    </a>

                    <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605"
                       target="_blank"
                       class="btn btn-outline-success">
                        Google Authenticator (iOS)
                    </a>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="mb-5">
                <div class="d-flex align-items-center mb-2">
                    <span class="badge bg-primary me-2">2</span>
                    <h3 class="mb-0">Scan the QR Code</h3>
                </div>

                <h6 class="text-secondary">
                    Open your authenticator app and scan the QR code below.
                </h6>

                <div class="text-center my-4">
                    <div id="qrCode" class="d-inline-block p-3 border rounded bg-white"></div>
                </div>

                <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>

                <div class="card bg-light">
                    <div class="card-body">
                        <div class="text-secondary mb-2">
                            Can't scan the QR code?
                        </div>

                        <div>
                            Enter this setup key manually:
                        </div>

                        <div class="mt-2">
                            <code class="fs-4">@Model.SharedKey</code>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 3 -->
            <div>
                <div class="d-flex align-items-center mb-2">
                    <span class="badge bg-primary me-2">3</span>
                    <h3 class="mb-0">Verify Setup</h3>
                </div>

                <h6 class="text-secondary">
                    After adding the account, enter the 6-digit code generated by your authenticator app.
                </h6>

                <form id="send-code" method="post">
                    <div class="row">
                        <div class="col-md-5">
                            <div class="mb-3">
                                <label asp-for="Input.Code" class="form-label">
                                    Verification Code
                                </label>

                                <input asp-for="Input.Code"
                                       class="form-control"
                                       autocomplete="off"
                                       placeholder="123456" />

                                <span asp-validation-for="Input.Code"
                                      class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-check me-1"></i>
                                Verify & Enable 2FA
                            </button>
                        </div>
                    </div>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mt-3"
                         role="alert">
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/qrcode/qrcode.js"></script>
    <script src="~/js/qr.js"></script>
}