@page
@model ChangePasswordModel

@{
    ViewData["Title"] = "Change Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="mb-4">
    <h2 class="page-title mb-1">
        <i class="ti ti-lock me-2"></i>
        Change Password
    </h2>
    <div class="text-secondary">
        Update your password to keep your account secure.
    </div>
</div>

<div class="row row-cards">

    <div class="col-lg-8">

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    Password Details
                </h3>
            </div>

            <div class="card-body">

                <form id="change-password-form" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.OldPassword" class="form-label"></label>
                        <div class="input-group input-group-flat">
                            <span class="input-group-text">
                                <i class="ti ti-lock"></i>
                            </span>
                            <input asp-for="Input.OldPassword"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Enter your current password" />
                        </div>
                        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label"></label>
                        <div class="input-group input-group-flat">
                            <span class="input-group-text">
                                <i class="ti ti-key"></i>
                            </span>
                            <input asp-for="Input.NewPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Enter a new password" />
                        </div>
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                        <div class="input-group input-group-flat">
                            <span class="input-group-text">
                                <i class="ti ti-check"></i>
                            </span>
                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Confirm your new password" />
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>
                            Update Password
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>

    <div class="col-lg-4">

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-shield-lock me-2"></i>
                    Security Tips
                </h3>
            </div>

            <div class="card-body">

                <div class="mb-3">
                    <strong>Use a strong password</strong>
                    <div class="text-secondary small">
                        Include uppercase letters, lowercase letters, numbers, and special characters.
                    </div>
                </div>

                <div class="mb-3">
                    <strong>Avoid reuse</strong>
                    <div class="text-secondary small">
                        Don't reuse passwords from other websites or applications.
                    </div>
                </div>

                <div>
                    <strong>Enable 2FA</strong>
                    <div class="text-secondary small">
                        Two-factor authentication provides an extra layer of protection for your account.
                    </div>
                </div>

            </div>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}