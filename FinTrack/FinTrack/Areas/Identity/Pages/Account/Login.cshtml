@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}


<div class="page page-center">
    <div class="container-tight py-4" style="max-width: 440px;">


        <!-- Logo -->
        <div class="text-center mb-4" style="margin-left: -20px;>
            <a href="/" class="text-decoration-none text-reset">
                <div class="d-flex align-items-center justify-content-center gap-2">

                    <i class="ti ti-chart-arrows-vertical fs-1 text-primary"></i>

                    <h1 class="mb-0 fw-bold">
                        FinTrack
                    </h1>

                </div>
            </a>
        </div>

        <!-- Login Card -->
        <div class="card card-md">

            <div class="card-body">

                <h2 class="h2 text-center mb-4">
                    Sign in to your account
                </h2>

                <form method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Input.Email"
                               class="form-label">
                        </label>

                        <input asp-for="Input.Email"
                               autocomplete="off"
                               class="form-control"
                               placeholder="your@email.com"
                               autocomplete="username" />

                        <span asp-validation-for="Input.Email"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">

                        <div class="d-flex justify-content-between">
                            <label asp-for="Input.Password"
                                   class="form-label">
                            </label>

                            <a asp-page="./ForgotPassword"
                               class="small">
                                Forgot password?
                            </a>
                        </div>

                        <div class="input-group input-group-flat">

                            <input asp-for="Input.Password"
                                   id="password"
                                   autocomplete="new-password"
                                   class="form-control"
                                   placeholder="Your password" />

                            <span class="input-group-text">
                                <a href="#"
                                   class="link-secondary"
                                   onclick="togglePassword()">

                                    <i class="ti ti-eye"></i>

                                </a>
                            </span>

                        </div>

                        <span asp-validation-for="Input.Password"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Remember me -->
                    <div class="mb-3">
                        <label class="form-check">

                            <input asp-for="Input.RememberMe"
                                   class="form-check-input">

                            <span class="form-check-label">
                                Remember me
                            </span>

                        </label>
                    </div>

                    <!-- Login Button -->
                    <div class="form-footer">
                        <button id="login-submit"
                                type="submit"
                                class="btn btn-primary w-100">
                            Sign In
                        </button>
                    </div>

                </form>
            </div>

            <!-- External Providers -->
            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="hr-text">or</div>

                <div class="card-body">

                    <form id="external-account"
                          asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        <div class="row">

                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <div class="col">

                                    <button type="submit"
                                            name="provider"
                                            value="@provider.Name"
                                            class="btn w-100">

                                        @provider.DisplayName

                                    </button>

                                </div>
                            }

                        </div>

                    </form>

                </div>
            }
        </div>

        <!-- Register -->
        <div class="text-center text-secondary mt-3">
            Don't have an account?
            <a asp-page="./Register"
               asp-route-returnUrl="@Model.ReturnUrl">
                Sign up
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword() {

            let password =
                document.getElementById("password");

            if (password.type === "password")
                password.type = "text";
            else
                password.type = "password";
        }
    </script>
}