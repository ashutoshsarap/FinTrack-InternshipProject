@using FinTrack.Models.ViewModels;
@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">
    <div class="col-12 d-flex justify-content-end gap-2">
        <a asp-action="Create" class="btn btn-primary rounded-pill">
            <i class="bi bi-file-plus"></i> + Add Transaction
        </a>
    </div>
    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="text-success fw-bold mb-1">
                Summary for @DateTime.Today.ToString("MMMM") @DateTime.Today.Year
            </h2>

            <p class="text-muted mb-0">
                Overview of your finances
            </p>

        </div>

    </div>


    <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-5">

        <!-- INCOME -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <p class="text-success mb-2 fs-5">
                        Total Income
                    </p>

                    <h3 class="fw-bold text-success mb-0">
                        ₹@Model.TotalIncome.ToString("N2")
                    </h3>

                    <div class="mt-4">

                        <div class="d-flex justify-content-between mb-2">

                            @if (Model.IncomePercentageChange > 0)
                            {
                                <small class="fw-semibold text-success fs-5">
                                    @Model.IncomePercentageChange% vs last month
                                </small>
                            }
                            else
                            {
                                <small class="fw-semibold text-danger fs-5">

                                    @Model.IncomePercentageChange% vs last month
                                </small>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- EXPENSES -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <p class="text-danger mb-2 fs-5">
                        Total Expenses
                    </p>

                    <h3 class="fw-bold text-danger mb-0">
                        ₹@Model.TotalExpenses.ToString("N2")
                    </h3>

                    <div class="mt-4">

                        <div class="d-flex justify-content-between mb-2">

                            @if (Model.ExpensePercentageChange > 0)
                            {
                                <small class="fw-semibold text-danger fs-5">
                                    @Model.ExpensePercentageChange% vs last month
                                </small>
                            }
                            else
                            {
                                <small class="fw-semibold text-success fs-5">
                                    @Model.ExpensePercentageChange% vs last month
                                </small>
                            }

                        </div>

                    </div>

                </div>

                

            </div>


        </div>


        <!-- BALANCE -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start mb-3">

                        <div>

                            <p class="text-primary mb-2 fs-5">
                                Net Balance
                            </p>

                            <h3 class="fw-bold text-primary mb-0">
                                ₹@Model.NetBalance.ToString("N2")
                            </h3>

                        </div>

                        <div class="bg-primary bg-opacity-10">

                            <i class="bi bi-wallet2 text-primary"></i>

                        </div>

                    </div>


                    <!-- SAVINGS RATE -->

                    <div class="mt-4">

                        <div class="d-flex justify-content-between align-items-center mb-2">

                            <small class="text-muted">
                                Savings Rate
                            </small>

                            <small class="fw-semibold text-success">

                                @Model.SavingsRate%

                            </small>

                        </div>

                        <div class="progress"
                             style="height:8px; border-radius:20px;">

                            <div class="progress-bar bg-success"
                                 role="progressbar"
                                 style="width:@Model.SavingsRate%">
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- CHART + BUDGET -->
    <div class="row g-4 mb-5">

        <!-- DOUGHNUT CHART -->
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="mb-4">

                        <h4 class="fw-bold mb-1">
                            Expense By Category
                        </h4>

                        <p class="text-muted mb-0">
                            Spending distribution across categories
                        </p>

                    </div>

                    <div class="d-flex justify-content-center align-items-center"
                         style="height:300px;">

                        <canvas id="expenseCategoryChart">
                        </canvas>

                    </div>

                </div>

            </div>

        </div>


        <!-- BUDGET PROGRESS -->
        <div class="col-lg-5">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h4 class="fw-bold mb-1">
                                Budget Progress
                            </h4>

                            <p class="text-muted mb-0">
                                Monthly spending limits
                            </p>

                        </div>

                        <a asp-controller="Budget"
                           asp-action="Index"
                           class="btn btn-light rounded-pill px-3">
                            Edit
                        </a>

                    </div>

                    @if (Model.BudgetAnalytics != null && Model.BudgetAnalytics.Any())
                    {
                        @foreach (var budget in Model.BudgetAnalytics)
                        {
                            decimal percentage =
                            budget.MonthlyLimitAmount == 0
                            ? 0
                            : (budget.TotalAmountSpent / budget.MonthlyLimitAmount) * 100;

                            string progressColor = percentage switch
                            {
                                <= 50 => "bg-success",
                                <= 80 => "bg-warning",
                                _ => "bg-danger"
                            };

                            <div class="mb-4">

                                <div class="d-flex justify-content-between align-items-center mb-2">

                                    <span class="fw-semibold">
                                        @budget.CategoryName
                                    </span>

                                    <span class="text-muted small">

                                        ₹@budget.TotalAmountSpent.ToString("N0")

                                        /

                                        ₹@budget.MonthlyLimitAmount.ToString("N0")

                                    </span>

                                </div>

                                <div class="progress"
                                     style="height:10px; border-radius:20px;">

                                    <div class="progress-bar @progressColor"
                                         role="progressbar"
                                         style="width:@(percentage > 100 ? 100 : percentage)%">
                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">

                            <p class="text-muted mb-0">
                                No budgets available.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- RECENT TRANSACTIONS -->
    <div>

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>

                <h4 class="fw-bold mb-1">
                    Recent Transactions
                </h4>

                <p class="text-muted mb-0">
                    Your latest financial activity
                </p>

            </div>

        </div>

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead style="background-color:#f8fafc;">

                            <tr>

                                <th class="border-0 px-4 py-3 text-muted fw-semibold">
                                    Title
                                </th>

                                <th class="border-0 py-3 text-muted fw-semibold">
                                    Category
                                </th>

                                <th class="border-0 py-3 text-muted fw-semibold">
                                    Type
                                </th>

                                <th class="border-0 py-3 text-muted fw-semibold">
                                    Amount
                                </th>

                                <th class="border-0 py-3 text-muted fw-semibold">
                                    Date
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (Model.RecentTransactions != null &&
                                                        Model.RecentTransactions.Any())
                            {
                                @foreach (var transaction in Model.RecentTransactions)
                                {
                                    <tr>

                                        <td class="px-4 py-3 fw-semibold">

                                            @transaction.Description

                                        </td>

                                        <td class="py-3 text-muted">

                                            @transaction.CategoryName

                                        </td>

                                        <td class="py-3">

                                            @if (transaction.Type.ToString() == "Expense")
                                            {
                                                <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill">
                                                    Expense
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                                                    Income
                                                </span>
                                            }

                                        </td>

                                        <td class="py-3 fw-semibold">

                                            ₹@transaction.Amount.ToString("N2")

                                        </td>

                                        <td class="py-3 text-muted">

                                            @transaction.Date.ToString("dd MMM yyyy")

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="5"
                                        class="text-center py-5 text-muted">

                                        No transactions found.

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>
        const categoryExpenseData =
        @Html.Raw(Json.Serialize(Model.ExpenseCategorySummaries));
    </script>

    <script src="~/js/dashboardCharts.js"></script>

}