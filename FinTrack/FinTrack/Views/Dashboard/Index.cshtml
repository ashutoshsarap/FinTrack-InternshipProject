@using FinTrack.Models.ViewModels;
@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <h2 class="mb-4">Financial Dashboard</h2>

    <!-- SUMMARY CARDS -->
    <div class="row mb-5">

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">

                    <h5 class="card-title text-success">
                        Total Income
                    </h5>

                    <h3>
                        ₹@Model.TotalIncome.ToString("N2")
                    </h3>

                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">

                    <h5 class="card-title text-danger">
                        Total Expenses
                    </h5>

                    <h3>
                        ₹@Model.TotalExpenses.ToString("N2")
                    </h3>

                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">

                    <h5 class="card-title text-primary">
                        Net Balance
                    </h5>

                    <h3>
                        ₹@Model.NetBalance.ToString("N2")
                    </h3>

                </div>
            </div>
        </div>

    </div>


    @* BUDGET PROGRESS *@

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h4 class="mb-0">
                    Budget Progress
                </h4>

                <a asp-controller="Budget"
                   asp-action="Index"
                   class="text-decoration-none fw-bold">
                    Edit
                </a>

            </div>

            @if (Model.BudgetAnalytics != null && Model.BudgetAnalytics.Any())
            {
                @foreach (var budget in Model.BudgetAnalytics)
                {
                    decimal percentage =
                    budget.MonthlyLimitAmount == 0
                    ? 0
                    : (budget.TotalAmountSpent / budget.MonthlyLimitAmount) * 100;

                    string progressColor = percentage switch
                    {
                        <= 50 => "bg-success",
                        <= 80 => "bg-warning",
                        _ => "bg-danger"
                    };

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <div>
                                <span class="fw-semibold">
                                    @budget.CategoryName
                                </span>
                            </div>

                            <div class="text-muted">

                                ₹@budget.TotalAmountSpent.ToString("N2")

                                /

                                ₹@budget.MonthlyLimitAmount.ToString("N2")

                            </div>

                        </div>

                        <div class="progress"
                             style="height:8px; border-radius:10px;">

                            <div class="progress-bar @progressColor"
                                 role="progressbar"
                                 style="width:@(percentage > 100 ? 100 : percentage)%">
                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <p class="text-muted mb-0">
                    No budgets available.
                </p>
            }

        </div>

    </div>


    <!-- EXPENSE CATEGORY SUMMARY -->
    <div class="mb-5">

        <h3 class="mb-3">Expense By Category</h3>

        <div class="card shadow-sm border-0">

            <div class="card-body">

                <table class="table table-striped align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Category</th>
                            <th>Total Expense</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.ExpenseCategorySummaries != null &&
                                                Model.ExpenseCategorySummaries.Any())
                        {
                            @foreach (var category in Model.ExpenseCategorySummaries)
                            {
                                <tr>

                                    <td>
                                        @category.CategoryName
                                    </td>

                                    <td>
                                        ₹@category.TotalAmount.ToString("N2")
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="2" class="text-center">
                                    No expense data available.
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- RECENT TRANSACTIONS -->
    <div>

        <h3 class="mb-3">Recent Transactions</h3>

        <div class="card shadow-sm border-0">

            <div class="card-body">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Date</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.RecentTransactions != null &&
                                                Model.RecentTransactions.Any())
                        {
                            @foreach (var transaction in Model.RecentTransactions)
                            {
                                <tr>

                                    <td>
                                        @transaction.Description
                                    </td>

                                    <td>
                                        @transaction.CategoryName
                                    </td>

                                    <td>

                                        @if (transaction.Type.ToString() == "Expense")
                                        {
                                            <span class="badge bg-danger">
                                                Expense
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Income
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        ₹@transaction.Amount.ToString("N2")
                                    </td>

                                    <td>
                                        @transaction.Date.ToString("dd MMM yyyy")
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5" class="text-center">
                                    No transactions found.
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>