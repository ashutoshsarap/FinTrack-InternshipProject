@using FinTrack.Models.ViewModels
@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <h2 class="mb-4">Financial Dashboard</h2>

    <div class="col-12 d-flex justify-content-end gap-2 mb-4">
        <a asp-controller="Transaction" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-file-plus"></i> Show all Transactions
        </a>

        <a asp-controller="Transaction" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-file-plus"></i> Add new transaction
        </a>

        <a asp-controller="Category" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-file-plus"></i> My Categories
        </a>

    </div>

    <div class="row mb-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-success">Total Income</h5>
                    <h3>₹ @Model.TotalIncome</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-danger">Total Expenses</h5>
                    <h3>₹ @Model.TotalExpenses</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary">Net Balance</h5>
                    <h3>₹ @Model.NetBalance</h3>
                </div>
            </div>
        </div>

    </div>

    <div class="row">

        <div class="col-md-5 mb-4">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    Expense By Category
                </div>

                <div class="card-body">

                    @if (Model.ExpenseCategorySummaries.Any())
                    {
                        <table class="table table-hover">

                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.ExpenseCategorySummaries)
                                {
                                    <tr>
                                        <td>@item.CategoryName</td>
                                        <td>₹@item.TotalAmount</td>
                                    </tr>
                                }

                            </tbody>

                        </table>
                    }
                    else
                    {
                        <p>No expense data found.</p>
                    }

                </div>
            </div>

        </div>

        <div class="col-md-7 mb-4">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-dark text-white">
                    Recent Transactions
                </div>

                <div class="card-body">

                    @if (Model.RecentTransactions.Any())
                    {
                        <table class="table table-striped">

                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Category</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Payment Mode</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var transaction in Model.RecentTransactions)
                                {
                                    <tr>

                                        <td>
                                            @transaction.Date.ToString("dd-MMM-yyyy")
                                        </td>

                                        <td>
                                            @transaction.CategoryName
                                        </td>

                                        <td>
                                            @transaction.Type
                                        </td>

                                        <td>
                                            ₹ @transaction.Amount
                                        </td>

                                        <td>
                                            @transaction.PaymentMode
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>
                    }
                    else
                    {
                        <p>No recent transactions found.</p>
                    }

                </div>

            </div>

        </div>

    </div>

</div>