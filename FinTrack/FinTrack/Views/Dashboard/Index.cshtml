@using FinTrack.Models.ViewModels;
@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">
    <div class="col-12 d-flex justify-content-end gap-2">
        <a asp-controller="Transaction" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-file-plus"></i> + Add Transaction
        </a>
    </div>
    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="text-primary fw-bold mb-1">
                Summary for @DateTime.Today.ToString("MMMM") @DateTime.Today.Year
            </h2>

            <h6 class="text-muted mb-0">
                Overview of your finances
            </h6>

        </div>

    </div>


    <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-5">

        <!-- INCOME -->
        <div class="col-md-4">

            <div class="card h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <span class="avatar avatar-md bg-success-lt me-3">

                            <i class="ti ti-arrow-up"></i>

                        </span>

                        <div>

                            <div class="text-success">
                                Total Income
                            </div>

                            <div class="h1 mb-0">

                                ₹@Model.TotalIncome.ToString("N2")

                            </div>

                            @if (@Model.IncomePercentageChange > 0)
                            {
                                <div class="text-success mt-2">

                                    ↑@Model.IncomePercentageChange% vs last month

                                </div>
                            }
                            else
                            {
                                <div class="text-danger mt-2">

                                    ↓@Math.Abs(Model.IncomePercentageChange)% vs last month

                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- EXPENSES -->
        <div class="col-md-4">

            <div class="card h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <span class="avatar avatar-md bg-danger-lt me-3">

                            <i class="ti ti-arrow-down"></i>

                        </span>

                        <div>

                            <div class="text-danger">
                                Total Expenses
                            </div>

                            <div class="h1 mb-0">

                                ₹@Model.TotalExpenses.ToString("N2")

                            </div>

                            @if (@Model.ExpensePercentageChange > 0)
                            {
                                <div class="text-danger mt-2">

                                    ↑@Math.Abs(Model.ExpensePercentageChange)% vs last month

                                </div>
                            }
                            else
                            {
                                <div class="text-success mt-2">

                                    ↓@Math.Abs(Model.ExpensePercentageChange)% vs last month

                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- BALANCE -->
        <div class="col-md-4">

            <div class="card h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-4">

                        <span class="avatar avatar-md bg-primary-lt me-3">

                            <i class="ti ti-wallet"></i>

                        </span>

                        <div>

                            <div class="text-primary">
                                Net Balance
                            </div>

                            <div class="h1 mb-0">

                                ₹@Model.NetBalance.ToString("N2")

                            </div>

                        </div>

                    </div>

                    <!-- Savings Rate -->

                    <div>

                        <div class="d-flex justify-content-between mb-2">

                            <span class="text-secondary">

                                Savings Rate

                            </span>

                            <span class="fw-bold text-success">

                                @Model.SavingsRate%

                            </span>

                        </div>

                        <div class="progress">

                            <div class="progress-bar bg-success"
                                 style="width:@Model.SavingsRate%">
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- CHART + BUDGET -->
    <div class="row row-cards mb-4">

        <!-- Expense Doughnut Chart -->

        <div class="col-lg-7">

            <div class="card h-100">

                <div class="card-header">

                    <div>

                        <h3 class="card-title">

                            Expense By Category

                        </h3>

                        <div class="text-secondary">

                            ₹@Model.TotalExpenses.ToString("N0") spent this month

                        </div>

                    </div>

                </div>

                <div class="card-body d-flex align-items-center justify-content-center">

                    @if (Model.ExpenseCategorySummaries != null &&
                                        Model.ExpenseCategorySummaries.Any())
                    {
                        <div class="chart-container">

                            <canvas id="expenseCategoryChart"></canvas>

                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">

                            <i class="ti ti-chart-donut text-secondary mb-3"
                               style="font-size:3rem;"></i>

                            <h5 class="fw-semibold mb-2">
                                No expense data available
                            </h5>

                            <h6 class="text-secondary mb-0">
                                Start adding expenses to see your spending breakdown.
                            </h6>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Budget Progress -->

        <div class="col-lg-5">

            <div class="card h-100">

                <div class="card-header">

                    <div class="d-flex justify-content-between align-items-center w-100">

                        <div>

                            <h3 class="card-title">

                                Budget Tracking

                            </h3>

                            <div class="text-secondary">

                                Monthly spending limits

                            </div>

                        </div>

                        <a asp-controller="Budget"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-primary">

                            Manage

                        </a>

                    </div>

                </div>

                <div class="card-body">

                    @if (Model.BudgetAnalytics != null &&
                                        Model.BudgetAnalytics.Any())
                    {
                        @foreach (var budget in Model.BudgetAnalytics)
                        {
                            decimal percentage =
                            budget.MonthlyLimitAmount == 0
                            ? 0
                            : (budget.TotalAmountSpent /
                            budget.MonthlyLimitAmount) * 100;

                            string progressColor = percentage switch
                            {
                                <= 50 => "bg-success",
                                <= 80 => "bg-warning",
                                _ => "bg-danger"
                            };

                            <div class="mb-4">

                                <div class="d-flex justify-content-between mb-2">

                                    <span class="fw-medium">

                                        @budget.CategoryName

                                    </span>

                                    <span class="text-secondary">

                                        ₹@budget.TotalAmountSpent.ToString("N0")
                                        /
                                        ₹@budget.MonthlyLimitAmount.ToString("N0")

                                    </span>

                                </div>

                                <div class="progress progress-sm">

                                    <div class="progress-bar @progressColor"
                                         role="progressbar"
                                         style="width:@(Math.Min(percentage, 100))%">
                                    </div>

                                </div>

                                <div class="mt-1 text-end">

                                    <small class="text-secondary">

                                        @percentage.ToString("N0")%

                                    </small>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex flex-column justify-content-center align-items-center h-100 text-center">

                            <i class="ti ti-target text-secondary mb-3"
                               style="font-size:3rem;"></i>

                            <h5 class="fw-semibold mb-2">
                                No budgets configured
                            </h5>

                            <h6 class="text-secondary mb-0">
                                Create a budget to start tracking your spending.
                            <h6/>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- RECENT TRANSACTIONS -->
    <div class="card">

        <div class="card-header">

            <div>

                <h3 class="card-title">

                    Recent Transactions

                </h3>

                <div class="text-secondary">

                    Your latest financial activity

                </div>

            </div>

        </div>

        <div class="list-group list-group-flush">

            @if (Model.RecentTransactions != null &&
                        Model.RecentTransactions.Any())
            {
                @foreach (var transaction in Model.RecentTransactions)
                {
                    bool isExpense =
                    transaction.Type.ToString() == "Expense";

                    <div class="list-group-item">

                        <div class="row align-items-center">

                            <!-- Icon -->

                            <div class="col-auto">

                                <span class="avatar @(isExpense ? "bg-danger-lt" : "bg-success-lt")">

                                    <i class="ti @(isExpense ? "ti-arrow-down" : "ti-arrow-up")"></i>

                                </span>

                            </div>

                            <!-- Description -->

                            <div class="col">

                                <div class="fw-medium">

                                    @transaction.Description

                                </div>

                                <div class="text-secondary">

                                    @transaction.CategoryName

                                </div>

                            </div>

                            <!-- Date -->

                            <div class="col-auto text-secondary">

                                @transaction.Date.ToString("dd MMM")

                            </div>

                            <!-- Amount -->

                            <div class="col-auto">

                                <span class="fw-bold @(isExpense ? "text-danger" : "text-success")">

                                    @(isExpense ? "-" : "+")
                                    ₹@transaction.Amount.ToString("N2")

                                </span>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="card-body text-center py-5">

                    <i class="ti ti-receipt text-secondary"
                       style="font-size:3rem;"></i>

                    <h4 class="mt-3">

                        No Transactions Found

                    </h4>

                    <p class="text-secondary mb-0">

                        Your recent transactions will appear here.

                    </p>

                </div>
            }

        </div>

    </div>

</div>


@section Scripts {

    <script>
        const categoryExpenseData =
        @Html.Raw(Json.Serialize(Model.ExpenseCategorySummaries));
    </script>

    <script src="~/js/dashboardCharts.js"></script>

}