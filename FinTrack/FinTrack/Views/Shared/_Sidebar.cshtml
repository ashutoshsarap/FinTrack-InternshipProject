@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<div class="page">
    <aside class="navbar navbar-vertical navbar-expand-sm position-absolute" data-bs-theme="dark">
        <div class="container-fluid">

            <div class="collapse navbar-collapse" id="sidebar-menu">
                <div class="sidebar-header d-flex align-items-center justify-content-between px-3 py-3">    
                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="sidebar-logo text-decoration-none d-flex align-items-center gap-2">

                        <i class="ti ti-chart-arrows-vertical"></i>

                        <span class="sidebar-logo-text">
                            FinTrack
                        </span>

                    </a>

                    <button id="sidebar-toggle" class="btn btn-icon">
                        <i class="ti ti-menu-2"></i>
                    </button>
                </div>
                <ul class="navbar-nav pt-3">

                    <li class="nav-item">
                        <span class="nav-link disabled text-uppercase sidebar-section">
                            Overview
                        </span>
                    </li>

                    <li class="nav-item @(currentController == "Dashboard" ? "active" : "")">
                        <a asp-controller="Dashboard" asp-action="Index" class="nav-link">
                            <span class="nav-link-icon">
                                <i class="ti ti-layout-dashboard"></i>
                            </span>
                            <span class="nav-link-title">
                                Dashboard
                            </span>
                        </a>
                    </li>

                    <li class="nav-item @(currentController == "Transaction" ? "active" : "")">
                        <a asp-controller="Transaction" asp-action="Index" class="nav-link">
                            <span class="nav-link-icon">
                                <i class="ti ti-arrows-exchange-2"></i>
                            </span>
                            <span class="nav-link-title">
                                Transactions
                            </span>
                        </a>
                    </li>

                    <li class="nav-item @(currentController == "Analytics" ? "active" : "")">
                        <a asp-controller="Analytics" asp-action="Index" class="nav-link">
                            <span class="nav-link-icon">
                                <i class="ti ti-chart-pie-2"></i>
                            </span>
                            <span class="nav-link-title">
                                Analytics
                            </span>
                        </a>
                    </li>

                    <li class="nav-item mt-3">
                        <span class="nav-link disabled text-uppercase sidebar-section">
                            Planning
                        </span>
                    </li>

                    <li class="nav-item @(currentController == "Budget" ? "active" : "")">
                        <a asp-controller="Budget" asp-action="Index" class="nav-link">
                            <span class="nav-link-icon">
                                <i class="ti ti-wallet"></i>
                            </span>
                            <span class="nav-link-title">
                                Budgets
                            </span>
                        </a>
                    </li>

                    <li class="nav-item @(currentController == "RecurringTransaction" ? "active" : "")">
                        <a asp-controller="RecurringTransaction" asp-action="Index" class="nav-link">
                            <span class="nav-link-icon">
                                <i class="ti ti-calendar-dollar"></i>
                            </span>
                            <span class="nav-link-title">
                                Recurring Transactions
                            </span>
                        </a>
                    </li>

                    <li class="nav-item @(currentController == "Category" ? "active" : "")">
                        <a asp-controller="Category" asp-action="Index" class="nav-link">
                            <span class="nav-link-icon">
                                <i class="ti ti-category-2"></i>
                            </span>
                            <span class="nav-link-title">
                                My Categories
                            </span>
                        </a>
                    </li>

                </ul>

            </div>
        </div>
    </aside>
