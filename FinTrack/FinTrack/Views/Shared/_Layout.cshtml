@using FinTrack.Utilities
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinTrack</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FinTrack.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index">FinTrack</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li> *@
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @if (User.Identity!.IsAuthenticated)
    {
        <div class="d-flex">

            <!-- Sidebar -->
            <div class="bg-dark text-white p-3" style="width:250px; min-height:100vh;">

                <h4 class="mb-4">Menu</h4>
                @if (User.IsInRole(Roles.User))
                {
                    <ul class="nav flex-column">

                        <li class="nav-item mb-2">
                            <a asp-controller="Dashboard"
                            asp-action="Index"
                            class="nav-link text-white">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item mb-2">
                            <a asp-controller="Analytics"
                            asp-action="Index"
                            class="nav-link text-white">
                                Analytics
                            </a>
                        </li>

                        <li class="nav-item mb-2">
                            <a asp-controller="Transaction"
                            asp-action="Index"
                            class="nav-link text-white">
                                Transactions
                            </a>
                        </li>

                        <li class="nav-item mb-2">
                            <a asp-controller="Transaction"
                            asp-action="Create"
                            class="nav-link text-white">
                                Add Transaction
                            </a>
                        </li>

                        <li class="nav-item mb-2">
                            <a asp-controller="Category"
                            asp-action="Index"
                            class="nav-link text-white">
                                My Categories
                            </a>
                        </li>

                        <li class="nav-item mb-2">
                            <a asp-controller="Budget"
                            asp-action="Index"
                            class="nav-link text-white">
                                Budgets
                            </a>
                        </li>

                        <li class="nav-item mb-2">
                            <a asp-controller="RecurringTransaction"
                            asp-action="Index"
                            class="nav-link text-white">
                                Recurring Transactions
                            </a>
                        </li>

                    </ul>                
                }
                @if (User.IsInRole("Admin"))
                {
                    <ul class="nav flex-column">

                        <li class="nav-item mb-2">
                            <a asp-controller="Admin"
                               asp-action="Index"
                               class="nav-link text-white">
                                Admin Dashboard
                            </a>
                        </li>

                        <li class="nav-item mb-2">
                            <a href="/hangfire"
                               class="nav-link text-white">
                                Hangfire Dashboard
                            </a>
                        </li>

                    </ul>
                }
            </div>

            <!-- Main Content -->
            <div class="container-fluid p-4">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

        </div>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

        <!-- Main Content -->
        <div class="container-fluid p-4">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

    </div>

    @* <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - FinTrack
        </div>
    </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
