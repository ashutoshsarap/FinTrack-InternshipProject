@using FinTrack.Models.AdminModelAndDtos.AdminViewModels
@model AdminDashboardViewModel


@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <div class="col-12 d-flex justify-content-end gap-2">
        <a asp-action="Create" class="btn btn-primary rounded-pill">
            <i class="bi bi-file-plus"></i> + Add New Admin
        </a>
    </div>
    <h2 class="mb-4">Admin Dashboard</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Users</h6>
                    <h2 class="fw-bold">@Model.TotalUsers</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Transactions</h6>
                    <h2 class="fw-bold">@Model.TotalTransactions</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Transactions This Month</h6>
                    <h2 class="fw-bold">@Model.TotalTransactionsThisMonth</h2>
                </div>
            </div>
        </div>

    </div>
</div>
