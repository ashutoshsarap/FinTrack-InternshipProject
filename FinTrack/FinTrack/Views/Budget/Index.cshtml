@using FinTrack.Models.ViewModels;
@model IEnumerable<BudgetCardViewModel>

@{
    ViewData["Title"] = "Budgets";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="mb-0">
            Budget Overview
        </h2>

        <a asp-action="Create"
           class="btn btn-primary rounded-pill">

            <i class="bi bi-plus-circle"></i>
            + Set Budget

        </a>

    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No budgets available.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var budget in Model)
            {
                string progressColor = budget.PercentageUsed switch
                {
                    <= 50 => "bg-success",
                    <= 80 => "bg-warning",
                    _ => "bg-danger"
                };

                float progressWidth =
                budget.PercentageUsed > 100
                ? 100
                : budget.PercentageUsed;

                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body d-flex flex-column">

                            <!-- TOP SECTION -->
                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <h4 class="mb-0">
                                    @budget.CategoryName
                                </h4>

                                @if (budget.IsOverBudget)
                                {
                                    <span class="badge bg-danger">
                                        Over Budget
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Safe
                                    </span>
                                }

                            </div>

                            <!-- SPENT / LIMIT -->
                            <div class="mb-3">

                                <div class="d-flex justify-content-between">

                                    <span class="text-muted">
                                        Spent
                                    </span>

                                    <span class="fw-semibold">
                                        @budget.TotalAmountSpent.ToString("C")
                                    </span>

                                </div>

                                <div class="d-flex justify-content-between">

                                    <span class="text-muted">
                                        Budget
                                    </span>

                                    <span class="fw-semibold">
                                        @budget.MonthlyLimitBudgetAmount.ToString("C")
                                    </span>

                                </div>

                            </div>

                            <!-- PROGRESS -->
                            <div class="mb-3">

                                <div class="d-flex justify-content-between mb-1">

                                    <small class="text-muted">
                                        Usage
                                    </small>

                                    <small class="fw-bold">
                                        @budget.PercentageUsed.ToString("0")%
                                    </small>

                                </div>

                                <div class="progress"
                                     style="height: 10px; border-radius: 10px;">

                                    <div class="progress-bar @progressColor"
                                         role="progressbar"
                                         style="width:@progressWidth%">
                                    </div>

                                </div>

                            </div>

                            <!-- REMAINING -->
                            <div class="mb-4">

                                <small class="text-muted d-block">
                                    Remaining Amount
                                </small>

                                <h5 class="mb-0">

                                    @budget.RemainingAmount.ToString("C")

                                </h5>

                            </div>

                            <!-- ACTION BUTTONS -->
                            <div class="mt-auto d-flex gap-2">

                                <a asp-action="Edit"
                                   asp-route-id="@budget.Id"
                                   class="btn btn-outline-primary w-100">

                                    <i class="bi bi-pencil-square"></i>
                                    Edit

                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@budget.Id"
                                      class="w-100">

                                    <button type="submit"
                                            class="btn btn-outline-danger w-100">

                                        <i class="bi bi-trash"></i>
                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>