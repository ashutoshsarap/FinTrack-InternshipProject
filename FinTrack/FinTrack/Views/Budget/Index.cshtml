@using FinTrack.Models.ViewModels;
@model IEnumerable<BudgetCardViewModel>

@{
    ViewData["Title"] = "Budgets";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="page-header d-print-none mb-4">
        <div class="row align-items-center">

            <div class="col">
                <div class="page-pretitle">
                    Finance Management
                </div>

                <h2 class="page-title">
                    Budget Overview
                </h2>
            </div>

            <div class="col-auto">
                <a asp-action="Create" class="btn btn-primary">

                    <i class="ti ti-plus"></i>

                    Set Budget

                </a>
            </div>

        </div>
    </div>



    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No budgets available.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var budget in Model)
            {
                string progressColor = budget.PercentageUsed switch
                {
                    <= 50 => "bg-success",
                    <= 80 => "bg-warning",
                    _ => "bg-danger"
                };

                float progressWidth =
                budget.PercentageUsed > 100
                ? 100
                : budget.PercentageUsed;

                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body d-flex flex-column">

                            <!-- TOP SECTION -->
                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <h4 class="mb-0">
                                    @budget.CategoryName
                                </h4>

                                <div class="d-flex gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@budget.Id"
                                       class="btn btn-icon bg-blue-lt text-blue">

                                        <i class="ti ti-edit"></i>

                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@budget.Id">

                                        <button type="submit"
                                                class="btn btn-icon bg-red-lt text-red">

                                            <i class="ti ti-trash"></i>

                                        </button>

                                    </form>

                                </div>

                            </div>

                            <!-- SPENT / LIMIT -->
                            <div class="mb-3">

                                <div class="d-flex justify-content-between">

                                    <span class="text-muted">
                                        Spent
                                    </span>

                                    <span class="fw-semibold">
                                        @budget.TotalAmountSpent.ToString("C")
                                    </span>

                                </div>

                                <div class="d-flex justify-content-between">

                                    <span class="text-muted">
                                        Budget
                                    </span>

                                    <span class="fw-semibold">
                                        @budget.MonthlyLimitBudgetAmount.ToString("C")
                                    </span>

                                </div>

                            </div>

                            <!-- PROGRESS -->
                            <div class="mb-3">

                                <div class="d-flex justify-content-between mb-1">

                                    <small class="text-muted">
                                        Usage
                                    </small>

                                    <small class="fw-bold">
                                        @budget.PercentageUsed.ToString("0")%
                                    </small>

                                </div>

                                <div class="progress"
                                     style="height: 10px; border-radius: 10px;">

                                    <div class="progress-bar @progressColor"
                                         role="progressbar"
                                         style="width:@progressWidth%">
                                    </div>

                                </div>

                            </div>

                            <!-- REMAINING -->
                            <div class="mb-4">

                                <small class="text-muted d-block">
                                    Remaining Amount
                                </small>

                                <h5 class="mb-0">

                                    @budget.RemainingAmount.ToString("C")

                                </h5>

                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-auto">

                                @if (budget.IsOverBudget)
                                {
                                    <span class="badge bg-danger-lt text-danger">

                                        Over Budget

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-lt text-success">

                                        On Track

                                    </span>
                                }

                            </div>

                            <!-- ACTION BUTTONS -->
                            

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>