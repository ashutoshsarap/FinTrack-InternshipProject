@using FinTrack.Models.ViewModels
@model IEnumerable<BudgetViewModel>

@{
    ViewData["Title"] = "Budgets";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="col-12 d-flex justify-content-end gap-2">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-file-plus"></i> Set budget
    </a>
</div>

<h1>Budgets</h1>

@if (Model == null || !Model.Any())
{
    <p>No Budgtes set yet</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Category Name</th>
                <th>Budget alloted</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.CategoryName</td>
                    <td>@b.MonthlyLimitAmount.ToString("C")</td>
                    <td>
                        <div class="w-75 btn-group" role="group">
                            <a asp-controller="Budget" asp-action="Edit" asp-route-id="@b.Id" class="btn btn-primary mx-2">
                                <i class="bi bi-pencil-square"></i>Edit
                            </a>
                            <form asp-controller="Budget" asp-action="Delete" asp-route-id="@b.Id">
                                <button type="submit" class="btn btn-danger mx-2">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}