@using FinTrack.Models.DTOs
@using FinTrack.Models.Enums
@using FinTrack.Models.ViewModels
@model RecurringTransactionViewModel

@{
    ViewData["Title"] = "Add Transaction";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>

}

<div class="row justify-content-center py-5">
    <div class="col-lg-8">

        <form method="post">

            <div class="card">

                <div class="card-body">

                    <div class="d-flex align-items-center mb-4">
                        <span class="avatar avatar-md bg-primary-lt me-3">
                            <i class="ti ti-receipt"></i>
                        </span>

                        <div>
                            <h3 class="card-title mb-1">
                                Add a Recurring Transaction
                            </h3>

                        </div>
                    </div>

                    <!-- Amount + Date -->

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="Amount" class="form-label"></label>

                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    ₹
                                </span>

                                <input asp-for="Amount" class="form-control" />
                            </div>

                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="StartDate" class="form-label"></label>

                            <input asp-for="StartDate"
                                   type="date"
                                   class="form-control"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   max="2050-01-01" />

                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>

                    </div>

                    <!-- Description -->

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Enter a note for this transaction">
                        </textarea>

                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <!-- Type + Payment -->

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="TransactionType" class="form-label">
                                Transaction Type
                            </label>

                            <select asp-for="TransactionType"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<TransactionType>()">
                                <option value="">
                                    Select Transaction Type
                                </option>
                            </select>

                            <span asp-validation-for="TransactionType" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="PaymentMode" class="form-label">
                                Payment Mode
                            </label>

                            <select asp-for="PaymentMode"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<PaymentMode>()">
                                <option value="">
                                    Select Payment Mode
                                </option>
                            </select>

                            <span asp-validation-for="PaymentMode" class="text-danger"></span>
                        </div>

                    </div>

                    <!-- Category -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                        <label asp-for="CategoryId" class="form-label">
                            Category
                        </label>

                        <select asp-for="CategoryId"
                                class="form-select"
                                asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                            <option value="">
                                Select Category
                            </option>
                        </select>

                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TransactionFrequency" class="form-label">
                                Transaction Frequency
                            </label>

                            <select asp-for="TransactionFrequency"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<TransactionFrequency>()">
                                <option value="">
                                    Select Frequency
                                </option>
                            </select>

                            <span asp-validation-for="TransactionFrequency" class="text-danger"></span>
                        </div>
                    </div>

                </div>

                <div class="card-footer bg-transparent">

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-controller="Transaction"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>
                            Save Transaction
                        </button>

                    </div>

                </div>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}