@using FinTrack.Models.ViewModels
@model IEnumerable<RecurringTransactionViewModel>

@{
    ViewData["Title"] = "Recurring Transactions";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
@if (TempData["ImportResult"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">

        @Html.Raw(TempData["ImportResult"])

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}


<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Recurring Transactions</h2>
            <div class="text-secondary">
                Manage subscriptions, bills and scheduled payments
            </div>
        </div>

        <div class="col-auto ms-auto">
            <a asp-action="Create" class="btn btn-primary">
                <i class="ti ti-plus"></i>
                Add Recurring Transaction
            </a>
        </div>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <h6>No Recurring Transactions available</h6>
}
else
{
    <table class="table">
        <div class="row row-cards">
            @foreach (var t in Model)
            {
                <div class="col-md-6 col-xl-4" id="recurringtransaction-@t.Id">
                    <div class="card">

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">

                                <div>
                                    <div class="fw-bold fs-5">
                                        @t.Description
                                    </div>

                                    <div class="text-secondary small">
                                        @t.CategoryName
                                    </div>
                                </div>

                                <div class="d-flex gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@t.Id"
                                       class="btn btn-icon bg-blue-lt text-blue">

                                        <i class="ti ti-edit fs-6"></i>

                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@t.Id"
                                          class="delete-recurringtransaction-form"
                                          data-id="@t.Id">

                                        <button type="submit"
                                                class="btn btn-icon bg-red-lt text-red">

                                            <i class="ti ti-trash fs-6"></i>

                                        </button>

                                    </form>

                                </div>

                            </div>
                            <div class="mt-3">

                                <div class="display-6 fw-bold">

                                    ₹@t.Amount.ToString("N0")

                                </div>

                            </div>
                            
                            <div class="mt-2">

                                @if (t.TransactionType.ToString() == "Expense")
                                {
                                    <span class="badge bg-red-lt">
                                        Expense
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-green-lt">
                                        Income
                                    </span>
                                }

                                <span class="badge bg-purple-lt ms-1">
                                    @t.TransactionFrequency
                                </span>

                            </div>
                            <hr />

                            <div class="d-flex justify-content-between align-items-center">

                                <div>

                                    <div class="text-secondary small">
                                        Next Due
                                    </div>

                                    <div class="fw-bold">
                                        @t.NextDueDate.ToString("dd MMM yyyy")
                                    </div>

                                </div>

                                <span class="badge bg-yellow-lt">

                                    @((t.NextDueDate - DateTime.Today).Days)

                                    days left

                                </span>

                            </div>
                            <div class="mt-3 text-secondary">

                                <i class="ti ti-credit-card"></i>

                                @t.PaymentMode

                            </div>  
                            
                        </div>


                    </div>
                </div>
            }
        </div>
    </table>
}

@section Scripts {
    <script src="~/js/recurringtransaction.js"></script>
}