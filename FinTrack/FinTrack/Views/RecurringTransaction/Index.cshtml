@using FinTrack.Models.ViewModels
@model IEnumerable<RecurringTransactionViewModel>

@{
    ViewData["Title"] = "Recurring Transactions";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
@if (TempData["ImportResult"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">

        @Html.Raw(TempData["ImportResult"])

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}

<div class="col-12 d-flex justify-content-end gap-2">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-file-plus"></i> Add new Recurring transaction
    </a>
</div>

<h1>Recurring Transactions</h1>


@if (Model == null || !Model.Any())
{
    <p>No Recurring Transactions available</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Description</th>
                <th>Category</th>
                <th>Amount</th>
                <th>Transaction Frequency</th>
                <th>Transaction type</th>
                <th>Payment mode</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Description</td>
                    <td>@t.CategoryName</td>
                    <td>@t.Amount</td>
                    <td>@t.TransactionFrequency</td>
                    <td>@t.TransactionType</td>
                    <td>@t.PaymentMode</td>
                    <td>
                        <div class="w-75 btn-group" role="group">
                            <a asp-controller="RecurringTransaction" asp-action="Edit" asp-route-id="@t.Id" class="btn btn-primary mx-2">
                                <i class="bi bi-pencil-square"></i>Edit
                            </a>
                            <form asp-controller="RecurringTransaction" asp-action="Delete" asp-route-id="@t.Id">
                                <button type="submit" class="btn btn-danger mx-2">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}