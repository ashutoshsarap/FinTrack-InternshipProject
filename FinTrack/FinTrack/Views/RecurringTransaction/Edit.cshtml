@using FinTrack.Models.DTOs
@using FinTrack.Models.Enums
@using FinTrack.Models.ViewModels
@model RecurringTransactionViewModel

@{
    ViewData["Title"] = "Edit Transaction";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>

}

<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Edit Recurring Transaction</h2>
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="Amount" class="p-0"></label>
            <input asp-for="Amount" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="Description" class="p-0"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>

        </div>
        <div class="mb-3 row p-1">
            <label asp-for="TransactionFrequency" class="p-0">Transaction Frequency</label>
            <select asp-for="TransactionFrequency" class="form-control" asp-items="Html.GetEnumSelectList<TransactionFrequency>()">
                <option value="">--Select Transaction Frequency--</option>
            </select>
            <span asp-validation-for="TransactionFrequency" class="text-danger"></span>
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="TransactionType" class="p-0">Transaction type</label>
            <select asp-for="TransactionType" class="form-control" asp-items="Html.GetEnumSelectList<TransactionType>()">
                <option value="">--Select Transaction type--</option>
            </select>
            <span asp-validation-for="TransactionType" class="text-danger"></span>
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="PaymentMode" class="p-0">Payment Mode</label>
            <select asp-for="PaymentMode" class="form-control" asp-items="Html.GetEnumSelectList<PaymentMode>()">
                <option value="">--Select Payment Mode--</option>
            </select>
            <span asp-validation-for="PaymentMode" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">Category</label>

            <select asp-for="CategoryId"
                    class="form-select"
                    asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                <option value="">-- Select Category --</option>

            </select>

            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="StartDate" class="p-0">Start date</label>
            <input asp-for="StartDate"
                   type="date"
                   class="form-control"
                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                   max="2050-01-01"/>
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-primary form-control">Edit</button>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="RecurringTransaction" asp-action="Index" class="btn btn-outline-secondary form-control">
                    Show all Recurring transactions
                </a>
            </div>
        </div>


    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}