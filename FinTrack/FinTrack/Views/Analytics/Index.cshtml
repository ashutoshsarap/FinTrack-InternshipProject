@using FinTrack.Models.ViewModels;
@model AnalyticsViewModel

@{
    ViewData["Title"] = "Analytics";
}

<div class="container mt-4">

    <div class="page-header mb-4">

        <div class="row align-items-center">

            <div class="col">

                <div class="page-pretitle">
                    FinTrack
                </div>

                <h2 class="page-title">
                    Analytics Dashboard
                </h2>

            </div>

        </div>

    </div>

    <!-- Analytics Cards -->
    <div class="row row-deck row-cards mb-4">

        <!-- Current Month -->

        <div class="col-sm-6 col-lg-4">

            <div class="card bg-blue-lt">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="subheader">
                            Current Month
                        </div>

                    </div>

                    <div class="h1 mb-3">
                        ₹@Model.Analytics.CurrentMonthExpense.ToString("N2")
                    </div>

                    <div class="text-secondary">
                        Total expenses this month
                    </div>

                </div>

            </div>

        </div>


        <!-- Previous Month -->

        <div class="col-sm-6 col-lg-4">

            <div class="card bg-indigo-lt">

                <div class="card-body">

                    <div class="subheader">
                        Previous Month
                    </div>

                    <div class="h1 mb-3">
                        ₹@Model.Analytics.PreviousMonthExpense.ToString("N2")
                    </div>

                    <div class="text-secondary">
                        Total expenses last month
                    </div>

                </div>

            </div>

        </div>


        <!-- Expense Change -->

        <div class="col-sm-6 col-lg-4">

            <div class="card bg-green-lt">

                <div class="card-body">

                    <div class="subheader">
                        Monthly Change
                    </div>

                    @if (Model.Analytics.ExpensePercentageChange > 0)
                    {
                        <div class="h1 text-danger mb-3">
                            ↑@Math.Abs(Model.Analytics.ExpensePercentageChange)%
                        </div>

                        <div class="text-secondary">
                            Spending increased
                        </div>
                    }
                    else if (Model.Analytics.ExpensePercentageChange < 0)
                    {
                        <div class="h1 text-success mb-3">
                            ↓@Math.Abs(Model.Analytics.ExpensePercentageChange)%
                        </div>

                        <div class="text-secondary">
                            Spending decreased
                        </div>
                    }
                    else
                    {
                        <div class="h1 mb-3">
                            0%
                        </div>

                        <div class="text-secondary">
                            No change
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>
    <div class="row row-cards mb-4">

        <div class="col-sm-6 col-lg-4">

            <div class="card">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <span class="avatar avatar-md bg-blue-lt me-3">
                            <i class="ti ti-calendar text-blue"></i>
                        </span>

                        <div>

                            <div class="subheader">
                                Daily Average
                            </div>

                            <div class="h2 mb-0">
                                ₹@Model.Analytics.AverageDailyExpense.ToString("N2")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-sm-6 col-lg-4">

            <div class="card">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <span class="avatar avatar-md bg-indigo-lt me-3">
                            <i class="ti ti-calendar-week text-indigo"></i>
                        </span>

                        <div>

                            <div class="subheader">
                                Weekly Average
                            </div>

                            <div class="h2 mb-0">
                                ₹@Model.Analytics.AverageWeeklyExpense.ToString("N2")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-sm-6 col-lg-4">

            <div class="card">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <span class="avatar avatar-md bg-green-lt me-3">
                            <i class="ti ti-crystal-ball text-green"></i>
                        </span>

                        <div>

                            <div class="subheader">
                                Predicted Expense This Month
                            </div>

                            <div class="h2 mb-0">
                                ₹@Model.Analytics.PredictedMonthlyExpense.ToString("N2")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
   


    <!-- Category Breakdown -->
    <div class="card mt-4">

        <div class="card-header">

            <div>

                <h3 class="card-title">
                    Spending Analysis
                </h3>

                <div class="text-secondary">
                    Expense distribution and monthly trend
                </div>

            </div>

        </div>

        <div class="card-body">

            <div class="row">
                
                <div class="col-lg-6">
                    <div class="text-dark">
                        Category-wise Expense Current vs Previous Month
                    </div>
                    @if (Model.CategoryBreakdown != null && Model.CategoryBreakdown.Any())
                    {
                        <canvas id="categoryAnalytics"></canvas>
                    }

                </div>
                
                <div class="col-lg-6">
                    <div class="text-dark">
                        Monthly Expense Trend
                    </div>
                    @if (Model.MonthlyExpenseTrends != null && Model.MonthlyExpenseTrends.Any())
                    {
                        <canvas id="monthlyExpenseTrend"></canvas>
                    }

                </div>

            </div>

        </div>

    </div>

    <!-- Insights Section -->

    <div class="card mt-4">

        <div class="card-header">
            <h4 class="mb-0">Insights</h4>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-lg-4 mb-3">

                    <div class="card h-100">

                        <div class="card-body">

                            <div class="d-flex align-items-center mb-2">

                                <i class="ti ti-calendar text-blue me-2"></i>

                                <span class="fw-semibold">
                                    Highest Spending Day
                                </span>

                            </div>

                            @if (Model.AnalyticsInsight.DateSpentMostOn == DateTime.MinValue)
                            {
                                <div class="h3 mb-1">
                                    N/A
                                </div>
                            }
                            else
                            {
                                <div class="h3 mb-1">
                                    @Model.AnalyticsInsight.DateSpentMostOn.ToString("dd MMM yyyy")
                                </div>
                            }

                            <div class="text-blue fw-bold">
                                ₹@Model.AnalyticsInsight.AmountSpentOnThatDay.ToString("N2")
                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-lg-4 mb-3">

                    <div class="card h-100">

                        <div class="card-body">

                            <div class="d-flex align-items-center mb-2">

                                <i class="ti ti-chart-pie text-green me-2"></i>

                                <span class="fw-semibold">
                                    Highest Expense Category
                                </span>

                            </div>

                            <div class="h3 mb-1 text-dark">
                                @Model.AnalyticsInsight.CategoryWithHighestExpense
                            </div>

                            <div class="text-green fw-bold">
                                ₹@Model.AnalyticsInsight.AmountSpentInHighestCategory.ToString("N2")
                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-lg-4 mb-3">

                    <div class="card h-100">

                        <div class="card-body">

                            <div class="d-flex align-items-center mb-2">

                                <i class="ti ti-receipt text-orange me-2"></i>

                                <span class="fw-semibold">
                                    Highest Expense
                                </span>

                            </div>

                            <div class="h2 text-orange mb-2">

                                ₹@Model.AnalyticsInsight?.HighestExpenseInfo?.Amount.ToString("N2")

                            </div>

                            <div class="text-secondary">

                                @Model.AnalyticsInsight?.HighestExpenseInfo?.Date.ToString("dd MMM yyyy")

                            </div>

                            <div class="mt-1 fw-medium">

                                @Model.AnalyticsInsight?.HighestExpenseInfo?.CategoryName

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts{
    <script> const categoryAnalysis = @Html.Raw(Json.Serialize(Model.CategoryBreakdown));</script>
    <script> const monthlyExpenseTrends = @Html.Raw(Json.Serialize(Model.MonthlyExpenseTrends));</script>
    <script src="~/js/analyticsCharts.js"></script>
}
