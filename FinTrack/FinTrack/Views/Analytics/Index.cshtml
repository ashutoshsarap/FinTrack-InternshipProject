@using FinTrack.Models.ViewModels;
@model AnalyticsViewModel

@{
    ViewData["Title"] = "Analytics";
}

<div class="container mt-4">

    <h2 class="mb-4">Analytics Dashboard</h2>

    <!-- Analytics Cards -->
    <div class="row">

        <div class="col-md-4 mb-3">
            <div class="card border-primary">
                <div class="card-body">
                    <h6 class="text-muted">Current Month Expense</h6>
                    <h3>₹@Model.Analytics.CurrentMonthExpense.ToString("N2")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card border-secondary">
                <div class="card-body">
                    <h6 class="text-muted">Previous Month Expense</h6>
                    <h3>₹@Model.Analytics.PreviousMonthExpense.ToString("N2")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card border-info">
                <div class="card-body">
                    <h6 class="text-muted">Expense % Change from previous month</h6>

                    @if (Model.Analytics.ExpensePercentageChange > 0)
                    {
                        <h3 class="text-danger">
                            <p>You spent @Math.Abs(Model.Analytics.ExpensePercentageChange).% more than previous month  📈</p>
                        </h3>
                    }
                    else if (Model.Analytics.ExpensePercentageChange < 0)
                    {
                        <h3 class="text-success">
                            <p>You spent @Math.Abs(Model.Analytics.ExpensePercentageChange).% less than previous month 📉</p>
                        </h3>
                    }
                    else
                    {
                        <h3>
                            No change
                        </h3>
                    }
                </div>
            </div>
        </div>

    </div>

    <div class="row">

        <div class="col-md-4 mb-3">
            <div class="card border-success">
                <div class="card-body">
                    <h6 class="text-muted">Average Daily Expense</h6>
                    <h3>₹@Model.Analytics.AverageDailyExpense.ToString("N2")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card border-warning">
                <div class="card-body">
                    <h6 class="text-muted">Average Weekly Expense</h6>
                    <h3>₹@Model.Analytics.AverageWeeklyExpense.ToString("N2")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card border-dark">
                <div class="card-body">
                    <h6 class="text-muted">Predicted Monthly Expense</h6>
                    <h3>₹@Model.Analytics.PredictedMonthlyExpense.ToString("N2")</h3>
                </div>
            </div>
        </div>

    </div>


    <!-- Insights Section -->

    <div class="card mt-4">

        <div class="card-header">
            <h4 class="mb-0">Insights</h4>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">

                    <div class="border rounded p-3 h-100">

                        <h6 class="text-muted">
                            Highest Spending Day
                        </h6>

                        @if(Model.AnalyticsInsight.DateSpentMostOn == DateTime.MinValue)
                        {
                            <h5>
                                N/A
                            </h5>
                        }
                        else
                        {
                            <h5>
                                @Model.AnalyticsInsight.DateSpentMostOn.ToString("dd-MMM-yyyy")
                            </h5>
                        }


                        <p class="mb-0">
                            Amount Spent:
                            <strong>
                                ₹@Model.AnalyticsInsight.AmountSpentOnThatDay.ToString("N2")
                            </strong>
                        </p>

                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <div class="border rounded p-3 h-100">

                        <h6 class="text-muted">
                            Highest Expense Category
                        </h6>

                        <h5>
                            @Model.AnalyticsInsight.CategoryWithHighestExpense
                        </h5>

                        <p class="mb-0">
                            Amount Spent:
                            <strong>
                                ₹@Model.AnalyticsInsight.AmountSpentInHighestCategory.ToString("N2")
                            </strong>
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Category Breakdown -->
    <div class="card mt-4">
        <div class="card-header">
            <h4 class="mb-0">Category Breakdown</h4>
        </div>

        <div class="card-body">

            @if (Model.CategoryBreakdown != null && Model.CategoryBreakdown.Any())
            {
                <canvas id="categoryAnalytics"></canvas>
            }
            else
            {
                <p>No category data available.</p>
            }

        </div>
    </div>

</div>

@section Scripts{
    <script> const categoryAnalysis = @Html.Raw(Json.Serialize(Model.CategoryBreakdown));</script>
    <script src="~/js/analyticsCategoryBreakdown.js"></script>
}
