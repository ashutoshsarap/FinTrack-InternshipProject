@using FinTrack.Models.DTOs
@model AnalyticsDto

@{
    ViewData["Title"] = "Analytics";
}

<h1>Analytics</h1>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-body mb-3">
            <div class="card-body">
                <h5 class="card-title">Previous month expense</h5>
                <p class="card-text fs-4">
                    @Model.PreviousMonthExpense.ToString("C")
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-secondary mb-3">
            <div class="card-body">
                <h5 class="card-title">Current month Expense</h5>
                <p class="card-text fs-4">
                    @Model.CurrentMonthExpense.ToString("C")
                </p>
            </div>
        </div>
    </div>
@{
    var change = Model.ExpensePercentageChange;

    var cardClass = change > 0
    ? "bg-danger"
    : change < 0
    ? "bg-success"
    : "bg-secondary";
}
    <div class="col-md-3">
        <div class="card text-white @cardClass mb-3">
            <div class="card-body">
                <h5 class="card-title">Percentage change</h5>
                <p class="card-text fs-4">
                    @Math.Abs(Model.ExpensePercentageChange).%
                </p>
                @if (Model.ExpensePercentageChange > 0)
                {
                    <p>You spent @Math.Abs(Model.ExpensePercentageChange).% more than previous month  📈</p>
                }
                else if (Model.ExpensePercentageChange < 0)
                {
                    <p>You spent @Math.Abs(Model.ExpensePercentageChange).% less than previous month 📉</p>
                }
                else
                {
                    <p>No change in expenses</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">Average spent daily</h5>
                <p class="card-text fs-4">
                    @Model.AverageDailyExpense.ToString("C")
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-secondary mb-3">
            <div class="card-body">
                <h5 class="card-title">Average spent weekly</h5>
                <p class="card-text fs-4">
                    @Model.AverageWeeklyExpense.ToString("C")
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-secondary mb-3">
            <div class="card-body">
                <h5 class="card-title">At this rate you will spend @Model.PredictedMonthlyExpense.ToString("C") this month </h5>
                <p class="card-text fs-4">
                    @Model.PredictedMonthlyExpense.ToString("C")
                </p>
            </div>
        </div>
    </div>

