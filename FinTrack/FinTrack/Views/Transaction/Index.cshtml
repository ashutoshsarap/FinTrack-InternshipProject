@using FinTrack.Models.ViewModels
@model IEnumerable<TransactionViewModel>

@{
    ViewData["Title"] = "Transactions";
}

<div class="col-6 text-end">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-file-plus"></i>Add new transaction
    </a>
</div>

<h1>Transactions</h1>

@if (Model == null || !Model.Any())
{
    <p>No Transactions available</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Category</th>
                <th>Description</th>
                <th>Amount</th>
                <th>Transaction type</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Date</td>
                    <td>@t.CategoryName</td>
                    <td>@t.Description</td>
                    <td>@t.Amount</td>
                    <td>@t.TransactionType</td>
                    <td>
                        <div class="w-75 btn-group" role="group">
                            <a asp-controller="Transaction" asp-action="Edit" asp-route-id="@t.Id" class="btn btn-primary mx-2">
                                <i class="bi bi-pencil-square"></i>Edit
                            </a>
                            <form asp-controller="Transaction" asp-action="Delete" asp-route-id="@t.Id" class="btn btn-primary mx-2">
                                <button type="submit" class="btn-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}