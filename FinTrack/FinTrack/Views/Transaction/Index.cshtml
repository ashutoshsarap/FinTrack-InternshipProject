@using FinTrack.Models.ViewModels
@model IEnumerable<TransactionViewModel>

@{
    ViewData["Title"] = "Transactions";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
@if (TempData["ImportResult"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">

        @Html.Raw(TempData["ImportResult"])

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}
<div class="alert alert-info mt-2">
    <strong>Allowed transaction type : </strong>
    Income,Expense
    <strong>Allowed Payment mode : </strong>
    Cash, UPI, Credit Card, Debit Card, NetBanking
    <br />
</div>
<div class="col-12 d-flex justify-content-end gap-2">
    <a asp-action="Create" class="btn btn-primary rounded-pill">
        <i class="bi bi-file-plus"></i> + Add Transaction
    </a>

    
    <a asp-controller="Csv" asp-action="DownloadCsv" class="btn btn-success rounded-pill">
        <i class="bi bi-file-plus"></i> Export to CSV
    </a>

    <form asp-action="UploadCsv"
          asp-controller="Csv"
          method="post"
          enctype="multipart/form-data">

        <!-- Hidden File Input -->
        <input type="file"
               id="csvFile"
               name="csvFile"
               accept=".csv"
               hidden
               onchange="this.form.submit()" />

        <!-- Custom Button -->
        <label for="csvFile"
               class="btn btn-success rounded-pill">
            <i class="bi bi-upload me-2"></i>
            Import CSV
        </label>

    </form>

    <a asp-action="DownloadCsvTemplate"
       asp-controller="Csv"
       class="btn btn-outline-primary rounded-pill">
        Download CSV Template
    </a>

</div>

<h1>Transactions</h1>

@* Filters *@

<form method="get">

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <label class="form-label fw-semibold">
                Start Date
            </label>

            <input type="date"
                   name="StartDate"
                   value="@ViewBag.Filter?.StartDate?.ToString("yyyy-MM-dd")"
                   class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold">
                End Date
            </label>

            <input type="date"
                   name="EndDate"
                   value="@ViewBag.Filter?.EndDate?.ToString("yyyy-MM-dd")"
                   class="form-control" />
        </div>

        <div class="col-md-2">
            <label class="form-label fw-semibold">
                Category
            </label>

            <select name="CategoryId"
                    class="form-select">

                <option value="">
                    All Categories
                </option>

                @foreach (var category in ViewBag.Categories)
                {
                    <option value="@category.Id" selected="@(ViewBag.Filter?.CategoryId == category.Id)">
                        @category.Name
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label fw-semibold">
                Type
            </label>

            <select name="TransactionType"
                    class="form-select">

                <option value="">
                    All Types
                </option>

                <option value="Income" selected="@(ViewBag.Filter?.TransactionType?.ToString() == "Income")">
                    Income
                </option>

                <option value="Expense" selected="@(ViewBag.Filter?.TransactionType?.ToString() == "Expense")">
                    Expense
                </option>

            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label fw-semibold">
                Payment Mode
            </label>

            <select name="PaymentMode"
                    class="form-select">

                <option value="">
                    All Modes
                </option>
                <option value="Cash" selected="@(ViewBag.Filter?.PaymentMode?.ToString() == "Cash")">Cash</option>
                <option value="UPI" selected="@(ViewBag.Filter?.PaymentMode?.ToString() == "UPI")">UPI</option>
                <option value="CreditCard" selected="@(ViewBag.Filter?.PaymentMode?.ToString() == "CreditCard")">Credit Card</option>
                <option value="DebitCard" selected="@(ViewBag.Filter?.PaymentMode?.ToString() == "DebitCard")">Debit Card</option>
                <option value="NetBanking" selected="@(ViewBag.Filter?.PaymentMode?.ToString() == "NetBanking")">Net banking</option>

            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label fw-semibold"">
                Sort By
            </label>
            <select name="SortBy"
                    class="form-select">
                <option value="">
                    Date (Oldest)
                </option>
                <option value="date_desc" selected="@(ViewBag.Filter?.SortBy == "date_desc")">
                    Date (Newest)
                </option>
                <option value="amount_desc" selected="@(ViewBag.Filter?.SortBy == "amount_desc")">
                    Amount (High to Low)
                </option>
                <option value="amount_asc" selected="@(ViewBag.Filter?.SortBy == "amount_asc")">
                    Amount (Low to High)
                </option>
            </select>
        </div>

    </div>

    

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            Apply Filter
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            Clear Filters
        </a>
    </div>

</form>


@if (Model == null || !Model.Any())
{
    <p>No Transactions available</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Category</th>
                <th>Amount</th>
                <th>Transaction type</th>
                <th>Payment mode</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Date.Date.ToString("dd-MMM-yyyy")</td>
                    <td>@t.Description</td>
                    <td>@t.CategoryName</td>
                    <td>@t.Amount</td>
                    <td>@t.TransactionType</td>
                    <td>@t.PaymentMode</td>
                    <td>
                        <div class="w-75 btn-group" role="group">
                            <a asp-controller="Transaction" asp-action="Edit" asp-route-id="@t.Id" class="btn btn-primary mx-2">
                                <i class="bi bi-pencil-square"></i>Edit
                            </a>
                            <form asp-controller="Transaction" asp-action="Delete" asp-route-id="@t.Id">
                                <button type="submit" class="btn btn-danger mx-2">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-center mt-4">

        @if (ViewBag.CurrentPage > 1)
        {
            <a asp-action="Index"
               asp-route-PageNumber="@(ViewBag.CurrentPage - 1)"
               class="btn btn-outline-primary me-2">
                Previous
            </a>
        }

        <span class="align-self-center">
            Page @ViewBag.CurrentPage of @ViewBag.TotalPages
        </span>

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <a asp-action="Index"
               asp-route-PageNumber="@(ViewBag.CurrentPage + 1)"
               class="btn btn-outline-primary ms-2">
                Next
            </a>
        }

    </div>
}