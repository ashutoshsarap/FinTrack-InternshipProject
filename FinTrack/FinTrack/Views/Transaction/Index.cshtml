﻿﻿@using FinTrack.Models.ViewModels
@model IEnumerable<TransactionViewModel>

@{
    ViewData["Title"] = "Transactions";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
@if (TempData["ImportResult"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">

        @Html.Raw(TempData["ImportResult"])

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}

<div class="card mb-4">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

            <div>

                <h3 class="card-title mb-0">
                    Transaction Tools
                </h3>

            </div>

            <div class="d-flex gap-2 flex-wrap">

                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-file-plus"></i> + Add Transaction
                </a>


                <a asp-controller="Csv" asp-action="DownloadCsv" class="btn btn-outline-success">
                    <i class="bi bi-file-plus"></i> Export to CSV
                </a>

                <form asp-action="UploadCsv"
                      asp-controller="Csv"
                      method="post"
                      enctype="multipart/form-data">

                    <!-- Hidden File Input -->
                    <input type="file"
                           id="csvFile"
                           name="csvFile"
                           accept=".csv"
                           hidden
                           onchange="this.form.submit()" />

                    <!-- Custom Button -->
                    <label for="csvFile"
                           class="btn btn-outline-success">
                        <i class="bi bi-upload me-2"></i>
                        Import CSV
                    </label>

                </form>

                <a asp-action="DownloadCsvTemplate"
                   asp-controller="Csv"
                   class="btn btn-outline-primary">
                    Download CSV Template
                </a>

            </div>

        </div>

    </div>

</div>

<div class="page-header mb-4">

    <div class="row align-items-center">

        <div class="col">

            <h2 class="page-title">

                Transactions

            </h2>

            <div class="text-secondary">

                Manage and track your financial activity

            </div>

        </div>

    </div>

</div>

@* Filters *@

<div class="card mb-4">

    <div class="card-header">

        <h3 class="card-title">
            Filters
        </h3>

    </div>

    <div class="card-body">

        <form method="get">

            <div class="row g-3 mb-4">

                <div class="col-md-2">
                    <label class="form-label fw-semibold">
                        Start Date
                    </label>

                    <input type="date"
                           name="StartDate"
                           value="@ViewBag.Filter?.StartDate?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">
                        End Date
                    </label>

                    <input type="date"
                           name="EndDate"
                           value="@ViewBag.Filter?.EndDate?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">
                        Category
                    </label>

                    <select name="CategoryId"
                            class="form-select">

                        <option value="">
                            All Categories
                        </option>

                        @foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.Id" selected="@(ViewBag.Filter?.CategoryId == category.Id)">
                                @category.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">
                        Type
                    </label>

                    <select name="TransactionType"
                            class="form-select">

                        <option value="">
                            All Types
                        </option>

                        <option value="Income" selected="@(ViewBag.Filter?.TransactionType?.ToString() == "Income")">
                            Income
                        </option>

                        <option value="Expense" selected="@(ViewBag.Filter?.TransactionType?.ToString() == "Expense")">
                            Expense
                        </option>

                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">
                        Payment Mode
                    </label>

                    <select name="PaymentMode"
                            class="form-select">

                        <option value="">
                            All Modes
                        </option>
                        <option value="Cash" selected="@(ViewBag.Filter?.PaymentMode?.ToString() == "Cash")">Cash</option>
                        <option value="UPI" selected="@(ViewBag.Filter?.PaymentMode?.ToString() == "UPI")">UPI</option>
                        <option value="CreditCard" selected="@(ViewBag.Filter?.PaymentMode?.ToString() == "CreditCard")">Credit Card</option>
                        <option value="DebitCard" selected="@(ViewBag.Filter?.PaymentMode?.ToString() == "DebitCard")">Debit Card</option>
                        <option value="NetBanking" selected="@(ViewBag.Filter?.PaymentMode?.ToString() == "NetBanking")">Net banking</option>

                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold">
                        Sort By
                    </label>
                    <select name="SortBy"
                            class="form-select">
                        <option value="">
                            Date (Oldest)
                        </option>
                        <option value="date_desc" selected="@(ViewBag.Filter?.SortBy == "date_desc")">
                            Date (Newest)
                        </option>
                        <option value="amount_desc" selected="@(ViewBag.Filter?.SortBy == "amount_desc")">
                            Amount (High to Low)
                        </option>
                        <option value="amount_asc" selected="@(ViewBag.Filter?.SortBy == "amount_asc")">
                            Amount (Low to High)
                        </option>
                    </select>
                </div>

            </div>



            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Apply Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Clear Filters
                </a>
            </div>

        </form>
    </div>
</div>


@if (Model == null || !Model.Any())
{
    <p>No Transactions available</p>
}
else
{
    <div class="card">

        @* <div class="card-header">

            <h3 class="card-title">
                Transaction History
            </h3>

        </div> *@

        <div class="table-responsive">

            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title">Transaction History</h3>
                <div class="ms-auto" style="width: 260px;">
                    <input type="text"
                           id="transactionSearch"
                           class="form-control"
                           placeholder="Search description, category..." />
                </div>
            </div>


            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Payment mode</th>
                        <th>Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr id="transaction-@t.Id">
                            <td>@t.Date.Date.ToString("dd-MMM-yyyy")</td>
                            <td>@t.Description</td>
                            <td>

                                <span class="badge bg-azure-lt">

                                    @t.CategoryName

                                </span>

                            </td>
                            <td>

                                <span class="badge bg-secondary-lt">

                                    @t.PaymentMode

                                </span>
                            <td>

                                @if (t.TransactionType.ToString() == "Income")
                                {
                                    <span class="text-success fw-bold">
                                        +₹@t.Amount
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold">
                                        -₹@t.Amount
                                    </span>
                                }

                            </td>


                            <td>
                                <div class="btn-list flex-nowrap">

                                    <a asp-action="Edit"
                                       asp-route-id="@t.Id"
                                       class="btn btn-outline-primary btn-sm">

                                        <i class="ti ti-pencil"></i>

                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@t.Id"
                                          class="delete-transaction-form"
                                          data-id="@t.Id">

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm">

                                            <i class="ti ti-trash"></i>

                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

    <div class="card-footer d-flex align-items-center">

        <h6 class="m-0 text-secondary">

            Page @ViewBag.CurrentPage of @ViewBag.TotalPages

        </h6>

        <ul class="pagination m-0 ms-auto">


            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-PageNumber="@(ViewBag.CurrentPage - 1)"
                   asp-route-StartDate="@ViewBag.Filter.StartDate.ToString("yyyy-MM-dd")"
                   asp-route-EndDate="@ViewBag.Filter.EndDate.ToString("yyyy-MM-dd")"
                   asp-route-TransactionType="@ViewBag.Filter.TransactionType"
                   asp-route-PaymentMode="@ViewBag.Filter.PaymentMode"
                   asp-route-CategoryId="@ViewBag.Filter.CategoryId"
                   asp-route-SortBy="@ViewBag.Filter.SortBy"
                   class="btn btn-outline-primary ms-2">
                    <i class="ti ti-arrow-narrow-left"></i>
                </a>
            }

            @* <span class="align-self-center">
            Page @ViewBag.CurrentPage of @ViewBag.TotalPages
        </span> *@

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-PageNumber="@(ViewBag.CurrentPage + 1)"
                   asp-route-StartDate="@ViewBag.Filter.StartDate.ToString("yyyy-MM-dd")"
                   asp-route-EndDate="@ViewBag.Filter.EndDate.ToString("yyyy-MM-dd")"
                   asp-route-TransactionType="@ViewBag.Filter.TransactionType"
                   asp-route-PaymentMode="@ViewBag.Filter.PaymentMode"
                   asp-route-CategoryId="@ViewBag.Filter.CategoryId"
                   asp-route-SortBy="@ViewBag.Filter.SortBy"
                   class="btn btn-outline-primary ms-1">
                    <i class="ti ti-arrow-narrow-right"></i>
                </a>
            }
        </ul>

    </div>

}

@section Scripts {
    <script src="~/js/transactions.js"></script>
}