@using FinTrack.Models.DTOs
@using FinTrack.Models.Enums
@using FinTrack.Models.ViewModels
@model TransactionViewModel

@{
    ViewData["Title"] = "Add Transaction";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
    
}

<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Add new Transaction</h2>
            </hr>
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="Amount" class="p-0"></label>
            <input asp-for="Amount" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="Description" class="p-0"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>

        </div>
        <div class="mb-3 row p-1">
            <label asp-for="Date" class="p-0"></label>
            <input asp-for="Date"
                    type="date"
                    class="form-control" 
                    min="2000-01-01"
                    max="@DateTime.Now.ToString("yyyy-MM-dd-HH-mm-ss")/>
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="TransactionType" class="p-0">Transaction type</label>
            <select asp-for="TransactionType" class="form-control" asp-items="Html.GetEnumSelectList<TransactionType>()">
                <option value="">--Select Transaction type--</option>
            </select>
            <span asp-validation-for="TransactionType" class="text-danger"></span>
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="PaymentMode" class="p-0">Payment Mode</label>
            <select asp-for="PaymentMode" class="form-control" asp-items="Html.GetEnumSelectList<PaymentMode>()">
                <option value="">--Select Payment Mode--</option>
            </select>
            <span asp-validation-for="PaymentMode" class="text-danger"></span>
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="CategoryId" class="p-0">Category</label>
            <select asp-for="CategoryId" class="form-control" asp-items="Model.Categories">
                <option value="">--Select Category--</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-primary form-control">Add</button>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Transaction" asp-action="Index" class="btn btn-outline-secondary form-control">
                    Show all transactions
                </a>
            </div>
        </div>


    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}