<div class="page-header mb-4">

    <div class="row align-items-center">

        <div class="col">

            <h2 class="page-title">
                👋 Good Afternoon, Ashutosh
            </h2>

            <div class="text-secondary">

                Here's your financial snapshot for June.

            </div>

        </div>

        <div class="col-auto">

            <a asp-action="Create"
               class="btn btn-primary">

                <i class="ti ti-plus"></i>

                Add Transaction

            </a>

        </div>

    </div>

</div>

<div class="row row-deck row-cards">

    <!-- Income -->

    <div class="col-sm-6 col-lg-3">

        <div class="card">

            <div class="card-body">

                <div class="d-flex align-items-center">

                    <span class="avatar avatar-md bg-success-lt me-3">

                        <i class="ti ti-arrow-up"></i>

                    </span>

                    <div>

                        <div class="text-secondary">
                            Income
                        </div>

                        <div class="h1 mb-0">
                            ₹50,000
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<div class="card">

    <div class="card-header">

        <div>

            <h3 class="card-title">

                Expense Breakdown

            </h3>

            <div class="text-secondary">

                ₹32,000 spent this month

            </div>

        </div>

    </div>

    <div class="card-body">

        <canvas id="expenseChart"></canvas>

    </div>

</div>


<div class="card">

    <div class="card-header">

        <h3 class="card-title">

            Budget Tracking

        </h3>

    </div>

    <div class="card-body">

        <div class="mb-4">

            <div class="d-flex justify-content-between">

                <strong>Food</strong>

                <span>₹4,000 / ₹5,000</span>

            </div>

            <div class="progress mt-2">

                <div class="progress-bar bg-warning"
                     style="width:80%">
                </div>

            </div>

        </div>

    </div>

</div>

<div class="card">

    <div class="card-header">

        <h3 class="card-title">

            Financial Insights

        </h3>

    </div>

    <div class="card-body">

        <div class="mb-3">

            <i class="ti ti-trending-down text-success"></i>

            Expenses decreased by 12%

        </div>

        <div class="mb-3">

            <i class="ti ti-pizza text-warning"></i>

            Food contributes 42% of expenses

        </div>

        <div>

            <i class="ti ti-pig-money text-primary"></i>

            Savings improved by 8%

        </div>

    </div>

</div>



<div class="card">

    <div class="card-header">

        <h3 class="card-title">

            Recent Transactions

        </h3>

    </div>

    <div class="list-group list-group-flush">

        <div class="list-group-item">

            <div class="row align-items-center">

                <div class="col-auto">

                    <span class="avatar bg-red-lt">

                        <i class="ti ti-burger"></i>

                    </span>

                </div>

                <div class="col">

                    <div class="fw-bold">

                        McDonalds

                    </div>

                    <div class="text-secondary">

                        Food

                    </div>

                </div>

                <div class="col-auto text-danger fw-bold">

                    - ₹250

                </div>

            </div>

        </div>

    </div>

</div>